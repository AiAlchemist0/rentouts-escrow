# Deploy config for the escrow contracts — copy to .env, never commit .env.
# Use a FRESH testnet-only EOA with no mainnet history.

# Deployer private key (Base Sepolia). Hex with 0x prefix.
PRIVATE_KEY=

# RPC endpoints
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org

# Basescan API key for contract verification (https://basescan.org/myapikey)
BASESCAN_API_KEY=

# ---------------------------------------------------------------- RentEscrow (Ethereum Sepolia)
# script/DeployEscrow.s.sol signs with a Foundry KEYSTORE (--account), never PRIVATE_KEY:
#   cast wallet import rentouts-deployer --interactive
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# Dispute arbiter (required, immutable in RentEscrow). An EOA or a contract: a single testnet EOA
# for the hackathon, a Safe multisig (or another arbiter contract, deployed first) in production.
# Must be SEPARATE: never the deployer (the demo landlord) and never a demo landlord or tenant.
ESCROW_ARBITER=

# Human gate (optional; the World ID seam). Empty = deploy a new HumanGate owned by the deployer,
# open until World is plugged in with setVerifier (no escrow redeploy). "none" = no gating, ever.
# Or the address of an existing IHumanGate.
ESCROW_HUMAN_GATE=

# Escrow token (optional). Default: Circle test USDC on Sepolia, 6 decimals.
ESCROW_TOKEN=0x1c7D4B196Cb0C7B01d743Fbc6116a902379C7238

# Existing LeaseShare1155 owned by the deployer (optional). Empty = deploy a new one.
# One LeaseShare1155 per RentEscrow: it must not be wired to an escrow yet (minter unset).
LEASE_SHARE=

# Etherscan API key for --verify (https://etherscan.io/myapikey)
ETHERSCAN_API_KEY=
