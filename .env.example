# Deploy config for the escrow contracts — copy to .env, never commit .env.
# Use a FRESH testnet-only EOA with no mainnet history.

# Deployer private key (Base Sepolia). Hex with 0x prefix.
PRIVATE_KEY=

# RPC endpoints
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org

# Basescan API key for contract verification (https://basescan.org/myapikey)
BASESCAN_API_KEY=
