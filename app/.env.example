# Copy to .env.local. Every value is optional; the ENS screens work with none of them.
# Sepolia JSON-RPC (default: https://ethereum-sepolia-rpc.publicnode.com)
VITE_SEPOLIA_RPC_URL=
# RentEscrow on Sepolia. Until it's set, the lease screens show "escrow not configured".
VITE_ESCROW_ADDRESS=
# LeaseShare1155 (Curvegrid RWA). If empty, the app reads RentEscrow.leaseShare().
VITE_LEASE_SHARE_ADDRESS=
# CredentialSync (writes rentouts.* ENS records from escrow stats).
VITE_CREDENTIAL_SYNC_ADDRESS=
# Escrow token (default: Circle USDC on Sepolia). If the escrow is set, RentEscrow.token() wins.
VITE_TOKEN_ADDRESS=
