# Copy to .env.local. Every value is optional; the ENS screens work with none of them.
# Contract addresses default to the repo-root deployments.json ("sepolia" / "sepoliaAIArbiter" entries,
# written by the deploy scripts). A value set here overrides the file.
# Sepolia JSON-RPC (default: https://ethereum-sepolia-rpc.publicnode.com)
VITE_SEPOLIA_RPC_URL=
# RentEscrow on Sepolia. Without it (or a deployments.json entry), the lease screens show "escrow not configured".
VITE_ESCROW_ADDRESS=
# AIArbiter (the escrow's arbiter: AI judge proposes, human arbiter overrides). If empty, the app checks
# whether RentEscrow.arbiter() is one.
VITE_AI_ARBITER_ADDRESS=
# LeaseShare1155 (Curvegrid RWA). If empty, the app reads RentEscrow.leaseShare().
VITE_LEASE_SHARE_ADDRESS=
# CredentialSync (writes rentouts.* ENS records from escrow stats).
VITE_CREDENTIAL_SYNC_ADDRESS=
# Escrow token (default: Circle USDC on Sepolia). If the escrow is set, RentEscrow.token() wins.
VITE_TOKEN_ADDRESS=
