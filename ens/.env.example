# ens/.env  (gitignored). No private keys here: signing uses the Foundry keystore.
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
# Address of your keystore account:  cast wallet address --account rentouts-deployer
DEPLOYER=
FOUNDRY_ACCOUNT=rentouts-deployer

# Parent name <label>.eth (available on ENSv2 Sepolia as of 2026-09-25 21:35 JST: rentouts)
ENS_PARENT_LABEL=rentouts
# REQUIRED: issuer EOA for credential writes. Must be a second account, not DEPLOYER (the deployer
# holds root resolver roles, which would hide the ENS key-scoped limit in the demo).
#   cast wallet new rentouts-issuer -p ; cast wallet address --account rentouts-issuer
ENS_ISSUER=

# Parent profile records (RentOuts' public identity, from rentouts-crypto public/.well-known/wallets.json)
ENS_PROFILE_ADDR=0x7ed696c879a1a7FD2eD3b49d9982E634a8647eb1
ENS_PROFILE_URL=https://rentouts.co
ENS_PROFILE_EMAIL=partners@rentouts.co
ENS_PROFILE_TWITTER=RentOuts
ENS_PROFILE_DESCRIPTION=RentOuts - on-chain rental identity and escrow (ETHGlobal Tokyo 2026, testnet)

# Go/no-go demo subname: <ENS_DEMO_LABEL>.<parent>.eth minted to ENS_DEMO_HOLDER.
# Use a fresh EOA (or a MetaMask smart account). Hardhat/anvil default accounts (0xf39F..., 0x7099...)
# are EIP-7702-delegated on Sepolia to code that rejects ERC-1155 and cannot receive a subname.
# Don't reuse this label/wallet for the live "claim" step on camera, and never rehearse revoke on it.
ENS_DEMO_LABEL=alice
ENS_DEMO_HOLDER=
